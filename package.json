{
  "name": "dronewatch-live",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Professional drone incident monitoring system with real-time updates",
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "build:next": "next build",
    "dev:automation": "node automation/server.js",
    "serve": "python3 -m http.server 8081",
    "update": "node automation/live-update-service.js",
    "scrape": "node automation/scrapers/rss-news-scraper.js",
    "build": "rm -rf dist && mkdir -p dist && cp index.html dist/index.html && cp incidents.json dist/incidents.json",
    "vercel-build": "npm run build",
    "build-assets": "python3 tools/build_assets.py",
    "automation": "node automation/index.js run",
    "automation:start": "node automation/index.js start",
    "automation:continuous": "node automation/continuous-monitor.js",
    "test": "npm run test:scraper && npm run test:enhanced && npm run test:final",
    "test:scraper": "node test-scraper.js",
    "test:enhanced": "node test-enhanced-scraper.js",
    "test:final": "node test-final-coverage.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-virtual": "^3.13.12",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "@types/supercluster": "^7.1.3",
    "autoprefixer": "^10.4.21",
    "cheerio": "^1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "playwright": "^1.55.1",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^3.1.1",
    "react-resizable-panels": "^3.0.6",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.7",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "ws": "^8.14.2",
    "xml2js": "^0.6.2",
    "zustand": "^5.0.8"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [
    "drone",
    "incident",
    "tracking",
    "automation",
    "europe",
    "security",
    "aviation"
  ],
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  }
}
